# Production environment for `docker compose up --build -d`.
# Copy to `.env` and edit the two values marked REQUIRED.
#
#   cp .env.example .env
#   docker compose up --build -d

# Port published on the host for the web editor.
WEB_PORT=80

# REQUIRED: public origin(s) of the app, comma-separated.
# Must include the exact origin users open in the browser,
# otherwise the API rejects credentialed requests with 403.
# Example: ALLOWED_ORIGINS=https://design.example.com
ALLOWED_ORIGINS=http://localhost

# MongoDB (internal service name `mongo`, no host port published).
MONGO_URL=mongodb://mongo:27017/zenuxs-desigen

# Behind nginx the app sees a proxy IP; trust X-Forwarded-* so
# rate limiting uses the real client IP.
TRUST_PROXY=true

# OIDC identity provider (defaults are the public Zenuxs values
# from packages/server/src/config.ts — override for self-hosted IdP).
#ZENUXS_ISSUER=https://api.auth.zenuxs.in
#ZENUXS_CLIENT_ID=d5695548c45c3ae5

# Optional session tuning (defaults in packages/server/src/config.ts).
#SESSION_TTL_MS=2592000000
#SESSION_RATE_LIMIT_MAX=20
