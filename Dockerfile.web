# Production build of the ZenuxsDesign web editor (Vite + Vue SPA).
# Stage 1 uses Bun (pinned to packageManager in package.json).
# The app resolves workspace packages via source aliases (vite/aliases.ts),
# so `vite build` alone is enough — no lint / package publishing needed.
FROM oven/bun:1.3.10 AS build

WORKDIR /app

# Install needs the workspace directories present (package.json lists
# packages/* and tools/* workspaces), so copy sources first.
# .dockerignore keeps the context lean (no node_modules/dist/.git).
COPY . ./
RUN bun install --frozen-lockfile

# Same-origin API: leave VITE_BACKEND_URL empty so the browser calls
# relative /api + /health, which nginx proxies to the api service.
# (Override at build time only if the API lives on another origin.)
ARG VITE_BACKEND_URL=""
ENV VITE_BACKEND_URL=${VITE_BACKEND_URL}

# Root `build` = build:packages + lint + vite build. Lint is skipped here
# (dev concern). The full build:packages also compiles heavy targets
# (vue/desktop tests hang it in constrained builders), so only the two
# workspace dists the web bundle resolves outside vite aliases are built:
# @open-pencil/mcp/tools and @open-pencil/harness (mcp neverBundles
# @open-pencil/core, so core dist is not required).
RUN bun run --cwd packages/mcp build && bun run --cwd packages/harness build && bunx vite build

FROM nginx:1.27-alpine AS runner

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1
